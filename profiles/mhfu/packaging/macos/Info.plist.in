<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Pokee</string>
	<key>CFBundleIconFile</key>
	<string>Pokee</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.teamgdb.pokee</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Pokee</string>
	<key>CFBundleDisplayName</key>
	<string>Pokee</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUNDLE_VERSION@</string>
	<key>CFBundleGetInfoString</key>
	<string>Pokee @VERSION@</string>
	<key>NSHumanReadableCopyright</key>
	<string>Pokee @VERSION@. MIT License. Includes no game assets.</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MINIMUM_SYSTEM_VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.action-games</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pokee connects to ad hoc servers and to other players on your network for multiplayer.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Pokee reads your disc image and saves you choose from the Desktop folder.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Pokee reads your disc image and saves you choose from the Documents folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Pokee reads your disc image and saves you choose from the Downloads folder.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Pokee reads your disc image and saves you choose from removable drives.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Pokee reads your disc image and saves you choose from network drives.</string>
</dict>
</plist>
