// Entry point of one overlay library, configured from the overlay's meta.txt by
// profiles/mhfu/CMakeLists.txt. Everything else in the library is psp_recomp
// output carrying the @MHFU_OVERLAY_PREFIX@ symbol prefix.
#define MHFU_OVERLAY_MODULE 1
#include "overlay_module.hpp"

#include "psprecomp/runtime.hpp"

namespace psprecomp {
void register_@MHFU_OVERLAY_PREFIX@_functions(Runtime &runtime);
}

namespace {

constexpr mhfu::OverlayModuleInfo kInfo{mhfu::kOverlayAbiVersion, @MHFU_OVERLAY_BASE@u,
                                          @MHFU_OVERLAY_SIZE@u, @MHFU_OVERLAY_CODE_SIZE@u,
                                          @MHFU_OVERLAY_HASH@ull, "@MHFU_OVERLAY_NAME@"};

// The calls the generated code makes through the runtime even within a unit,
// so a host wrapper at them sees every one; 0 ends the list.
constexpr std::uint32_t kDispatchedCalls[] = {@MHFU_OVERLAY_DISPATCH_LIST@0u};

} // namespace

const mhfu::OverlayModuleInfo *mhfu_overlay_info() { return &kInfo; }

const std::uint32_t *mhfu_overlay_dispatched_calls() { return kDispatchedCalls; }

void mhfu_register_overlay(psprecomp::Runtime &runtime) {
    psprecomp::register_@MHFU_OVERLAY_PREFIX@_functions(runtime);
}
